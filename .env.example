# Copy this file to `.env` and adjust values for your machine.
# Never commit real production secrets.

# PostgreSQL connection string used by the indexer and integration tests.
# Default (Docker Compose / standard local container):
DATABASE_URL=postgres://chainwatch:chainwatch@127.0.0.1:5432/chainwatch
#
# For local Homebrew / Postgres.app users (peer or trust auth using your macOS username):
# DATABASE_URL=postgres://<username>@127.0.0.1:5432/chainwatch
# (Replace <username> with your local macOS username, e.g. run `whoami`)

# JSON-RPC URL of the EVM node. Anvil's default HTTP port is 8545.
RPC_URL=http://127.0.0.1:8545

# Expected chain id. Anvil defaults to 31337. The process refuses to start on mismatch.
CHAIN_ID=31337

# First block to index when no checkpoint exists yet. Genesis is 0.
START_BLOCK=0

# Only index blocks this many confirmations behind the chain tip.
# Use 0 for a local Anvil demo so events appear immediately.
# Use 12 (or similar) against a public network.
CONFIRMATION_DEPTH=0

# How often the indexer polls for a new chain tip, in milliseconds.
POLL_INTERVAL_MS=1000

# Maximum in-flight RPC requests. This is the backpressure valve against the node.
MAX_CONCURRENT_REQUESTS=8

# Retry count for transient RPC failures. Total attempts = MAX_RETRIES + 1.
MAX_RETRIES=5

# Per-request HTTP timeout for JSON-RPC calls.
REQUEST_TIMEOUT_SECONDS=10

# How many blocks to fetch concurrently before persisting them in order.
BATCH_SIZE=20

# Optional ERC-20 contract address. Leave empty to index Transfer events from every contract.
CONTRACT_ADDRESS=

# HTTP API bind address.
API_HOST=127.0.0.1
API_PORT=8080

# Tracing filter. Examples: info, chainwatch_rs=debug,sqlx=warn
RUST_LOG=chainwatch_rs=info,sqlx=warn,tower_http=info
